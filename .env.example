# Backend Environment Configuration (FlameSight BFF API Gateway)
APP_NAME="FlameSight BFF Gateway"
APP_VERSION="v0.1-hackathon"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# Upstream flamesight AI/RAG microservice URL (Leave blank to use scientifically grounded stub fallback)
AI_SERVICE_URL=""

# Local SQLite Database Path (automatically seeded if missing)
DB_PATH="data/flamesight.db"

# In-memory query TTL cache (seconds)
CACHE_TTL_SECONDS=300

# Upstream proxy timeout (seconds)
TIMEOUT_SECONDS=10.0

# CORS Allowed Origins (comma-separated or wildcard)
ALLOWED_ORIGINS="*"
